# -----------------------------------------------------------------
# LiteLLM proxy
# -----------------------------------------------------------------
# Protects the proxy. `make init` generates it - leave empty here.
LITELLM_MASTER_KEY=

# -----------------------------------------------------------------
# LLM providers - fill in at least one API key.
# *_MODEL = LiteLLM model name "<provider>/<model>", see https://docs.litellm.ai/docs/providers
# -----------------------------------------------------------------

# Anthropic - https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=anthropic/claude-haiku-5-5

# OpenAI - https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-5.4-nano

# Google Gemini - https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini/gemini-2.5-flash

# OpenRouter (free models) - https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/google/gemma-4-31b-it:free
# Alternatives (free + tool calling, tested 2026-10-20):
# OPENROUTER_MODEL=openrouter/nvidia/nemotron-3.5-super-vl:free
# OPENROUTER_MODEL=openrouter/google/gemma-4-26b-a4b-it:free
# OPENROUTER_MODEL=openrouter/google/gemma-4-31b-it:free
# OPENROUTER_MODEL=openrouter/xingchen-agi/xing4.0-29b-a4b:free
# OPENROUTER_MODEL=openrouter/poolside/laguna-xs-2.1:free
