# LiteLLM proxy key. Leave empty: `make init` generates it.
LITELLM_MASTER_KEY=

# Providers: one API key is enough. Both agents use the alias "anthropic" by default.
# Model names: https://docs.litellm.ai/docs/providers (the model must support tool calling)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=anthropic/claude-haiku-5-5
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-5.4-nano
GEMINI_API_KEY=
GEMINI_MODEL=gemini/gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/google/gemma-4-31b-it:free

# Database passwords. Leave empty: `make init` generates them.
# POSTGRES_PASSWORD is the superuser, AGENT_DB_PASSWORD is the role both agents connect with.
POSTGRES_PASSWORD=
AGENT_DB_PASSWORD=

# Login to the n8n editor at http://localhost:5679. Leave the password empty: `make init` generates it.
N8N_OWNER_EMAIL=admin@example.com
N8N_OWNER_PASSWORD=
